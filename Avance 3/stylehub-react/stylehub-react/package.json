{
  "name": "stylehub-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api": "json-server --watch db.json --port 3001",
    "start": "concurrently -k -n API,WEB -c yellow,cyan \"npm run api\" \"npm run dev\""
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "alova": "^3.5.5",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "json-server": "^0.17.4",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
